{
  description = "grimoire: my computing environment, built with Denix";
  outputs = inputs @ {
    self,
    nixpkgs,
    denix,
    treefmt-nix,
    ...
  }: let
    inherit (nixpkgs) lib;
    systems = ["aarch64-darwin" "aarch64-linux" "x86_64-linux"];
    forAllSystems = lib.genAttrs systems;

    # Module check fixtures are composed on the same adapters and extensions.
    compose = abstractions:
      denix.lib.denixConfiguration {
        extraInputs = inputs;
        specialArgs.mylib = import ./lib {inherit lib;};

        modules =
          [
            denix.denixModules.nixDarwin
            ./adapters/hjem
            ./adapters/bundles.nix
            ./extensions/hosts.nix
            ./extensions/module-constraints.nix
            ./extensions/module-dependencies.nix
            ./extensions/module-metadata.nix
            ./extensions/module-tests.nix
            ./extensions/provenance.nix
            ./extensions/rices.nix
          ]
          ++ abstractions;
      };

    configuration = compose (lib.fileset.toList (
      lib.fileset.fileFilter
      (file: file.name == "default.nix")
      ./abstractions
    ));

    hosts = configuration.config.hosts;

    # Declarations are evaluated for one system, so the reference is the same
    # on every system that renders it. Defaults read a placeholder host whose
    # values are the `myconfig.host` expressions they stand for; its system
    # stays real because nix-darwin and packages are evaluated for it.
    authoringReference = import ./lib/authoring.nix {inherit lib;} (let
      docsSystem = "aarch64-darwin";
      host = "\${myconfig.host.name}";
      userName = "\${myconfig.host.user.name}";
      homeDirectory = "\${myconfig.host.user.homeDirectory}";
      placeholder = configuration.extendModules {
        modules = [
          ({delib, ...}:
            delib.host {
              name = host;
              system = docsSystem;
              user = {
                name = userName;
                inherit homeDirectory;
              };
            })
        ];
      };
    in {
      inherit host;
      sources = lib.mapAttrs (_: input: input.outPath) (removeAttrs inputs ["self"]);
      configuration = placeholder;
      root = self;
      pkgs = nixpkgs.legacyPackages.${docsSystem};
      moduleSystems = {
        hjem =
          (configuration.genSystem {
            moduleSystem = "hjem";
            extraArgs = {
              inherit homeDirectory;
              system = docsSystem;
              username = userName;
            };
          }).options;
        darwin =
          (placeholder.genSystem {
            moduleSystem = "darwin";
            inherit host;
          }).options;
        bundles =
          (configuration.genSystem {
            moduleSystem = "bundles";
            extraArgs.system = docsSystem;
          }).options;
      };
    });

    perSystem = forAllSystems (system: let
      pkgs = nixpkgs.legacyPackages.${system};
      treefmt = treefmt-nix.lib.evalModule pkgs {
        projectRootFile = "flake.nix";
        # Generated by bun2nix; checks/bun-lock compares it with raw bun2nix output.
        settings.global.excludes = ["**/bun.nix"];
        programs = {
          alejandra.enable = true;
          deadnix.enable = true;
          # Modules write each module system's sections as separate
          # `<system>.always`/`<system>.ifEnabled` keys.
          statix = {
            enable = true;
            disabled-lints = ["repeated_keys"];
          };
          # JSON and Markdown stay out: Bun rewrites package.json, and
          # docs/generated is compared with `just docs` output.
          oxfmt = {
            enable = true;
            includes = ["*.ts" "*.tsx" "*.js" "*.jsx" "*.mjs" "*.cjs"];
          };
          just = {
            enable = true;
            indentation = "  ";
          };
        };
        # Lint fixes run before alejandra, which formats their rewrites.
        settings.formatter.statix.priority = 1;
        settings.formatter.deadnix.priority = 2;
        settings.formatter.alejandra.priority = 3;
        settings.formatter.crystal = {
          command = "${pkgs.crystal}/bin/crystal";
          options = ["tool" "format"];
          includes = ["*.cr"];
        };
        # Style comes from the nearest .luafmt.toml.
        settings.formatter.luafmt = {
          command = "${pkgs.emmylua-formatter}/bin/luafmt";
          options = ["--write"];
          includes = ["*.lua"];
        };
      };
      publishedBundles =
        (configuration.genSystem {
          moduleSystem = "bundles";
          extraArgs = {inherit system;};
        }).packages;
      existingPackages = {
        hjem = inputs.hjem.packages.${system}.hjem;
        authoring-docs = authoringDocs;
      };
      packageCollisions = builtins.attrNames (builtins.intersectAttrs existingPackages publishedBundles);

      authoringDocs = pkgs.writeText "authoring.md" authoringReference;
      checkOutputs = import ./checks {
        inherit inputs denix pkgs system configuration compose authoringDocs;
        formatting = treefmt.config.build.check self;
      };
      commitHooks = import ./git-hooks.nix {
        inherit pkgs system;
        inherit (inputs) git-hooks;
        src = self;
      };
    in {
      packages =
        if packageCollisions != []
        then throw "Published bundles collide with existing packages: ${lib.concatStringsSep ", " packageCollisions}"
        else existingPackages // publishedBundles;

      devShells.default = pkgs.mkShellNoCC {
        packages = [
          pkgs.just
          pkgs.nushell
          pkgs.bun
          pkgs.oxfmt
          pkgs.oxlint
          pkgs.tsgolint
          inputs.bun2nix.packages.${system}.default
          pkgs.emmylua-ls
          pkgs.emmylua-check
          self.packages.${system}.hjem
        ];
        inherit (commitHooks) shellHook;
      };

      formatter = treefmt.config.build.wrapper;
      inherit checkOutputs;
      inherit (checkOutputs) checks;
    });
  in {
    packages = lib.mapAttrs (_: outputs: outputs.packages) perSystem;
    devShells = lib.mapAttrs (_: outputs: outputs.devShells) perSystem;
    formatter = lib.mapAttrs (_: outputs: outputs.formatter) perSystem;
    checks = lib.mapAttrs (_: outputs: outputs.checks) perSystem;
    lib.checks = lib.mapAttrs (_: outputs: outputs.checkOutputs.metadata) perSystem;
    # Composes abstractions as module test fixtures are; the live nix-secrets
    # check composes its probe with it.
    lib.compose = compose;

    darwinConfigurations =
      builtins.mapAttrs
      (hostName: _:
        configuration.genSystem {
          moduleSystem = "darwin";
          host = hostName;
        })
      (lib.filterAttrs
        (_: host: (lib.systems.elaborate host.system).isDarwin)
        hosts);

    hjemConfigurations =
      lib.mapAttrs'
      (hostName: host:
        # The Hjem CLI reads this attribute set as JSON; option declarations
        # serve generated references only.
          lib.nameValuePair "${host.user.name}@${hostName}" (builtins.removeAttrs (configuration.genSystem {
            moduleSystem = "hjem";
            host = hostName;

            extraArgs = {
              inherit (host) system;
              inherit (host.user) homeDirectory;
              username = host.user.name;
            };
          }) ["options"]))
      hosts;
  };

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs/nixpkgs-unstable";
    denix = {
      url = "github:yunfachi/denix/rewrite";
      inputs = {
        nixpkgs.follows = "nixpkgs";
      };
    };
    nix-darwin = {
      url = "github:nix-darwin/nix-darwin/master";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    hjem = {
      url = "github:feel-co/hjem";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    nix-secrets = {
      url = "github:unnamed-systems/nix-secrets/151f264a22b595802647db8fac09a2dbd6cb202c";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    mnw.url = "github:Gerg-L/mnw";
    nix-wrapper-modules = {
      url = "github:nix-community/nix-wrapper-modules";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    neovim-nightly-overlay.url = "github:nix-community/neovim-nightly-overlay";
    # nixpkgs only packages blink.cmp 1.x; the upstream flake builds v2 with
    # its Rust fuzzy matcher and blink.lib dependency.
    blink-cmp = {
      url = "github:saghen/blink.cmp";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    cask2nix = {
      url = "github:glassesneo/cask2nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    # Cask data for the official homebrew/cask tap, bound to cask2nix by the casks module.
    brew-api = {
      url = "github:BatteredBunny/brew-api";
      flake = false;
    };
    # Cask data for third-party taps, bound to cask2nix by the casks module.
    brew-taps-api = {
      url = "github:glassesneo/brew-taps-api";
      flake = false;
    };
    # Not following nixpkgs keeps the dependencies upstream CI pushes to
    # vicinae.cachix substitutable.
    vicinae.url = "github:vicinaehq/vicinae";
    nix-mac-app-identity = {
      url = "github:natsukium/nix-mac-app-identity";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    # Installs the Karabiner VirtualHID driver Kanata needs on macOS and
    # runs Kanata through kanata-bar.
    kanata-darwin = {
      url = "github:not-in-stock/kanata-darwin";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    # nixpkgs does not package elio.
    elio = {
      url = "github:elio-fm/elio";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    llm-agents.url = "github:numtide/llm-agents.nix";
    # nix-community/bun2nix rejects the lockfile version 2 written by Bun 1.4
    # (nix-community/bun2nix#110); llm-agents carries a fork that accepts it.
    bun2nix.follows = "llm-agents/bun2nix";
    git-hooks = {
      url = "github:cachix/git-hooks.nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    treefmt-nix = {
      url = "github:numtide/treefmt-nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };
}
