{
  "compilerOptions": {
    "target": "ESNext", "module": "Preserve", "moduleResolution": "bundler",
    "jsx": "preserve", "jsxImportSource": "@opentui/solid", "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "noEmit": true, "skipLibCheck": true, "types": ["bun"]
  },
  "include": ["*.ts", "*.tsx", "ui/*.ts", "ui/*.tsx", "contributions/*.ts", "../client/*.ts", "../../../../../tests/shield-process/*.ts", "../../../../../tests/shield-trace/*.ts"]
}
